{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>chainringlabs/renovate-config"
  ],
  "packageRules": [
    {
      "description": "UI framework updates - review carefully due to potential breaking changes",
      "matchDatasources": [
        "crate"
      ],
      "matchPackageNames": [
        "ratatui",
        "crossterm"
      ],
      "automerge": false,
      "labels": [
        "ui-update"
      ]
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    }
  ]
}
